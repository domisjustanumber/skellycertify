// Configuration of the relay. It holds no secret and no account id.
// Secrets go to Cloudflare with `npx wrangler secret put <NAME>` (see README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skellycertify-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      // Invocation logs record request metadata. The relay writes its own log line with no address.
      "invocation_logs": false
    }
  },
  "vars": {
    "RELAY_ENABLED": "true",
    "TEST_MODE": "false",
    "GITHUB_REPO": "domisjustanumber/skellycertify",
    "GITHUB_API_URL": "https://api.github.com"
  },
  // Rate Limiting bindings. Each count is per Cloudflare location and approximate.
  // The period must be 10 or 60 seconds. Keep these numbers equal to src/ratelimit.js.
  // namespace_id: a positive integer as a string, unique in the Cloudflare account.
  "ratelimits": [
    {
      // Per sender: the key is a salted hash of the sender address.
      "name": "SENDER_LIMIT",
      "namespace_id": "71001",
      "simple": { "limit": 2, "period": 60 }
    },
    {
      // All senders: the key is "all".
      "name": "BURST_LIMIT",
      "namespace_id": "71002",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
